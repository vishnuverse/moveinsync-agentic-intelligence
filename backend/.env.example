# Copy to backend/.env and fill in real values. backend/.env is gitignored — never commit it.

LLM_PROVIDER=sarvam
# sarvam-105b (reasoning variant) can return empty content — its invisible
# reasoning_content consumes the token budget before visible output. Use the
# conversations variant, which returns clean output.
LLM_MODEL=sarvam-105b-conversations
SARVAM_API_KEY=

# Optional — leave blank to keep OpenRouter inactive.
OPENROUTER_API_KEY=

DATABASE_URL=postgresql://moveinsync:moveinsync@postgres:5432/moveinsync
REDIS_URL=redis://redis:6379/0

LLM_DAILY_CALL_LIMIT=500
