VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000/api
# Optional: override the WebSocket base for the Live feed (SP-A). If unset, it
# is derived from VITE_API_BASE_URL (http->ws, https->wss; a relative base like
# "/api" resolves against the page origin). Example:
# VITE_WS_BASE_URL=ws://localhost:8000/api
# Optional: override the SSE base for live Notification/Activity updates. If
# unset, it is derived from VITE_API_BASE_URL (used as-is when absolute; a
# relative base resolves against the page origin). Example:
# VITE_SSE_BASE_URL=http://localhost:8000/api
